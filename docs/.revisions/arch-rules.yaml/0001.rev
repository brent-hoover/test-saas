# Machine-readable architecture rules. Source of truth for generated
# architecture tests (Python: tests/test_architecture.py, Go:
# architecture_test.go). Module names are language-neutral; paths are
# derived at scaffold time (Python: src/<root>/<module>, Go:
# internal/<module>).
version: 1
language: python
root: test_saas
modules:
  - name: identity
    may_import: []
  - name: settings
    may_import: []
  - name: token_verification
    may_import: [settings]
  - name: api
    may_import: [identity, settings, token_verification]
rules:
  # `no_cycles` is the only supported rule — checked against the may_import
  # graph. To forbid a dependency, omit it from may_import (the whitelist).
  # No naming/label/size rules — the tests can't enforce them.
  - no_cycles: true
